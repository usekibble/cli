{
  "name": "@usekibble/cli",
  "version": "0.3.0",
  "description": "Kibble collector -- reports AI coding agent token usage. Counts only, never content.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "verify": "pnpm build && node scripts/verify-accuracy.mjs"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "tokens",
    "cost",
    "observability"
  ],
  "author": "Kibble <hello@usekibble.com>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "kibble": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usekibble/cli.git"
  },
  "dependencies": {
    "@tokscale/cli": "4.14.0",
    "@tokscale/core": "1.4.3",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "homepage": "https://usekibble.com",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/usekibble/cli/issues"
  }
}
